name: server.js ci

on: 
  push:
    branches:
      - break
  pull_request:
    branches:
      - break
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Use Node.js 18
        uses: actions/setup-node@v3
        with:
          node-version: 18
      - run: npm install
      - run: npm test
      - run: npm run build

  scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3
        with:
          fetch-depth: 0  # Ensures full commit history for Gitleaks
      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v2
        